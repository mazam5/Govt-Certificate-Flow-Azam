# Server Configuration
PORT=5000
NODE_ENV=development

# Database & Storage
DATABASE_URL=postgresql://certiflow:certiflow_secret@localhost:5432/certiflow?schema=public
CERTIFICATE_STORAGE_PATH=./storage/certificates

# Caching & Queue Backbone
REDIS_URL=redis://localhost:6379

# SLA Review Timeout (ms) - 15000 for rapid local demo; 172800000 (48h) for production
SLA_TIMEOUT_MS=15000

# Client Application URL
FRONTEND_URL=http://localhost:5173
